{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "as_of_date", "research_id", "snapshot_hash", "reviewer_type", "candidate_assessments", "ready_candidates", "priority_order", "human_approval_prompt_required"],
  "properties": {
    "phase": {"const": "5.5"},
    "as_of_date": {"type": "string", "format": "date"},
    "research_id": {"type": "string"},
    "snapshot_hash": {"type": "string"},
    "reviewer_type": {"type": "string"},
    "candidate_assessments": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "candidate_version", "candidate_hash", "research_id", "snapshot_hash", "status", "reviewed_at", "checklist", "blockers"],
        "properties": {
          "candidate_id": {"type": "string"},
          "candidate_version": {"type": "string"},
          "candidate_hash": {"type": "string"},
          "research_id": {"type": "string"},
          "snapshot_hash": {"type": "string"},
          "status": {"enum": ["READY_FOR_HUMAN_REVIEW", "NEEDS_CHANGES", "BLOCKED", "REJECTED"]},
          "reviewed_at": {"type": "string", "format": "date"},
          "checklist": {"type": "object"},
          "blockers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "ready_candidates": {"type": "array", "items": {"type": "string"}},
    "priority_order": {"type": "array", "items": {"type": "string"}},
    "human_approval_prompt_required": {"type": "boolean"}
  }
}
